# Virtual Environment
venv/
.venv/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# macOS
.DS_Store

# Environment variables
.env

# Build / cache
build/
dist/
*.egg-info/

# TensorFlow intermediate export
models/saved_model/

# VSCode workspace cache
.vscode/*.log

# Dataset images (folder structure is tracked, images are not)
dataset/**/*.jpg
dataset/**/*.jpeg
dataset/**/*.png
!dataset/**/.gitkeep

# Training outputs (folder structure is tracked, artifacts are not)
outputs/models/*
outputs/tflite/*
outputs/reports/*
outputs/android_assets/*
!outputs/**/.gitkeep
